# Billoop configuration — copy to .env and edit

# Port the web app listens on
PORT=5358

# Admin password for the dashboard (change this!)
ADMIN_PASSWORD=change-me

# SQLite database location
DB_PATH=./data/billoop.db

# SMTP for outgoing email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
